# =========================
# Environment configuration
# =========================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# =========================
# Data source configuration
# =========================
# test: data/test_user を参照（デフォルト）
# prod: data/user を参照
DATA_SOURCE=test

# =========================
# Logging configuration
# =========================
AGENT_LOG_ENABLED=true
AGENT_LOG_DIR=logs

# =========================
# 実行するワークフローを決定する
# =========================
# react: reasning + acting
# fix: 事前定義
AGENT_PIPELINE_MODE=react